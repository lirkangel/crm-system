# Rendered by the image entrypoint (envsubst over CRM_SERVER_URL, CRM_PUBLIC_PROXY_SECRET, REAL_IP_FROM,
# HOTEL_HOST, DENTAL_HOST). CRM_SERVER_URL is scheme://host:port with no path and no trailing slash
# (05-check-env.sh enforces it, and that both hosts are DNS names).
# This is the only internet-facing piece: it serves the pages and proxies ONE public API per host, nothing else.
#
#   HOTEL_HOST   (exact name)  -> /api/v1/plugins/hotel/public/   only
#   DENTAL_HOST  (exact name)  -> /api/v1/plugins/dental/public/  only
#   any other Host             -> 404 for everything, "/" included, except /healthz (the k8s probe: pod IP as Host)
#
# What the two hosts share (hardening, static pages, the catch-all /api 404) lives in two snippets so the blocks
# cannot drift: site-common.conf (server level) and proxy-common.conf (inside the proxied location).

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;
    include /etc/nginx/snippets/security-headers.conf;
    # Liveness/readiness probe: answers with any Host.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
        include /etc/nginx/snippets/security-headers.conf;
    }
    # An unknown Host is not served at all: no page, no API.
    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name ${HOTEL_HOST};
    include /etc/nginx/conf.d/snippets/site-common.conf;

    # ^~ beats every regex location, and the URI is normalised before matching, so /public/../reservations
    # never reaches this block.
    location ^~ /api/v1/plugins/hotel/public/ {
        limit_except GET POST DELETE { deny all; }
        # With a URI part nginx forwards the NORMALISED path, not the raw request URI.
        proxy_pass ${CRM_SERVER_URL}/api/v1/plugins/hotel/public/;
        include /etc/nginx/conf.d/snippets/proxy-common.conf;
    }

    # The bare prefix would otherwise get nginx's slash-adding 301.
    location = /api/v1/plugins/hotel/public {
        return 404;
    }
}

server {
    listen 8080;
    server_name ${DENTAL_HOST};
    include /etc/nginx/conf.d/snippets/site-common.conf;

    location ^~ /api/v1/plugins/dental/public/ {
        limit_except GET POST { deny all; }
        proxy_pass ${CRM_SERVER_URL}/api/v1/plugins/dental/public/;
        include /etc/nginx/conf.d/snippets/proxy-common.conf;
    }

    location = /api/v1/plugins/dental/public {
        return 404;
    }
}

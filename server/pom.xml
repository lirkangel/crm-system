<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.crm</groupId>
    <artifactId>crm-server-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>crm-server-parent</name>
    <description>CRM server reactor: plugin contract, foundation and bundled plugins</description>

    <modules>
        <module>plugin-api</module>
        <module>foundation</module>
    </modules>

    <!-- ─────────────────────────────────── versions ─── -->
    <properties>
        <java.version>21</java.version>
        <!-- 1.21.4+: negotiates the Docker API version; 1.20.x speaks API 1.32, which Docker Engine 29 rejects -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Must match annotationProcessorPaths; Boot 3.4.1 defaults to 1.18.36, which breaks JDK 25 javac -->
        <lombok.version>1.18.46</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <jjwt.version>0.12.6</jjwt.version>
        <poi.version>5.3.0</poi.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <springdoc.version>2.8.5</springdoc.version>
    </properties>

</project>
